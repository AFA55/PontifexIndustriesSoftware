<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Pontifex Industries</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- App Store encryption export compliance — HTTPS only (exempt from EAR) -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!-- Privacy usage descriptions — required by App Store -->
	<!-- Location (Phase C): used to verify you're at the job site at clock-in AND,
	     for field workers on the clock, in the BACKGROUND to auto-detect arrival at
	     the job site and remind you to clock out when you return to the shop. Only
	     active while an operator is clocked in / has an assigned job. ⚠️ The privacy
	     policy + in-app GPS consent MUST disclose this and users MUST re-consent
	     before background tracking is enabled in production. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Pontifex uses your location to confirm you're at the job site when you clock in.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Pontifex uses your location in the background while you're on the clock to automatically log when you arrive at a job site and to remind you to clock out when you return to the shop. You can turn this off in Settings.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Pontifex uses the camera to capture job site photos and document completed work.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Pontifex uses Face ID to securely sign you in without typing your password.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Pontifex uses the microphone for voice-based equipment checkout and job notes.</string>
	<!-- Speech recognition: on-device transcription of spoken equipment checkout
	     commands (e.g. "gas power pack number 4 to Zack"), so a shop worker can
	     sign equipment out hands-free. Required in addition to the microphone
	     key above because iOS gates SFSpeechRecognizer separately. -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Pontifex uses speech recognition to transcribe voice commands for hands-free equipment checkout.</string>
	<!-- NFCReaderUsageDescription removed: the iOS app has no native NFC (badge
	     scanning is Android-only via Web NFC; iOS uses a PIN fallback). -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Pontifex saves job site photos to your photo library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Pontifex accesses your photo library to attach images to job reports.</string>
</dict>
</plist>
